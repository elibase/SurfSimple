# Google Cloud project settings
GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1

# Local dev only — path to service account key JSON file.
# On Cloud Run this is NOT needed; attach the service account to the Cloud Run service instead.
GCP_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# Port for local development (Cloud Run overrides this automatically with its own PORT)
PORT=3001

# Shared secret — must match the SHARED_SECRET constant in extension/lib/gemmaProxy.js
SHARED_SECRET=replace-with-a-strong-random-string
